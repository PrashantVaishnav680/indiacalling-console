# ============================================================================
# INDIACALLING CONSOLE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to `.env.local` for local dev, or add these keys in Vercel
# (Project Settings -> Environment Variables). NEVER commit `.env` or `.env.local`.
# ============================================================================

# 1. MongoDB Atlas / Local MongoDB Connection String
# Note: URL-encode special characters in password (e.g. '@' -> '%40')
MONGODB_URI=mongodb+srv://<username>:<encoded_password>@<cluster>.mongodb.net/indiacalling_console?retryWrites=true&w=majority

# 2. Authentication & Session Security (32+ byte random secret)
# Keep this value stable in production so user sessions remain valid across deploys
JWT_SECRET=replace_with_a_strong_32_byte_random_hex_secret_key
JWT_EXPIRES_IN=7d

# 3. Official Bolna AI Voice Infrastructure (API v2)
# Obtain your Bearer API key from https://platform.bolna.ai -> Developers
BOLNA_API_KEY=bn-your_bolna_api_key_here
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_WEBHOOK_SECRET=your_optional_webhook_secret

# 4. Google Gemini AI Prompt Assistant (Google AI Studio)
# Generate an API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 5. Public Application URL
# Local: http://localhost:3000 | Vercel: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# 6. Billing & Wallet Top-Up Configuration
# Manual UPI ID displayed for verified UPI/UTR wallet top-ups
INDIACALLING_UPI_ID=payments@indiacalling

# Optional: Razorpay Instant Top-Up Verification (leave blank for UPI/UTR only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 7. Optional: Allow `npm run seed` on production DB (keep false/unset in prod)
ALLOW_PROD_SEED=false
